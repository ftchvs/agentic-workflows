{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ftchvs/agentic-workflows/schema/workflow.schema.json",
  "title": "Agentic Workflow",
  "description": "A repo-native operating file for controlled AI work.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "goal",
    "trigger",
    "inputs",
    "allowed_tools",
    "authority",
    "risk_level",
    "required_permissions",
    "external_side_effects",
    "destructive_actions",
    "dry_run",
    "approval_required",
    "steps",
    "verification",
    "artifacts",
    "memory_update"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "trigger": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "allowed_tools": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "authority": {
      "type": "string",
      "enum": [
        "read_only",
        "local_write",
        "external_draft",
        "external_write_requires_approval",
        "destructive_forbidden"
      ]
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "read-only",
        "local-write",
        "external-write",
        "destructive",
        "credentialed"
      ],
      "description": "Public safety label for the workflow."
    },
    "required_permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "description": "Permissions or access the workflow needs before it can run."
    },
    "external_side_effects": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "description": "External reads, writes, network calls, posts, messages, or account actions the workflow may cause."
    },
    "destructive_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "description": "Delete, overwrite, revoke, merge, publish, or other hard-to-reverse actions."
    },
    "dry_run": {
      "type": "string",
      "minLength": 1,
      "description": "Default no-side-effect behavior and what the workflow emits before any gated action."
    },
    "approval_required": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "description": "Actions that require explicit human approval before execution."
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "memory_update": {
      "type": "string",
      "minLength": 1,
      "description": "What durable, public-safe lesson should be saved after the workflow completes."
    }
  }
}
